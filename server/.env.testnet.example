# ECNA Testnet API — production path: /opt/ecnascan-testnet/server/.env
# See docs/ADDRESSES-LIVE.md

NODE_ENV=production
NETWORK_KIND=testnet
PORT=4001

DATABASE_URL="sqlserver://127.0.0.1:1433;database=Db_ECNATestnet;user=sa;password={CHANGE_ME};encrypt=true;trustServerCertificate=true"

RPC_URL=http://127.0.0.1:18545
RPC_PUBLIC_URL=https://testnetrpc.ecnascan.com
RPC_CHAIN_ID=4112
CHAIN_ID=4112

NATIVE_SYMBOL=tECNA
NATIVE_NAME=E Canna Testnet
CHAIN_DISPLAY_NAME=E Canna Testnet

ECNA_PRIMARY_ADDRESS=0x9F926a69ba55c2F436A51108f8eb96E21fC5a329
ECNA_VALIDATORS=0x9F926a69ba55c2F436A51108f8eb96E21fC5a329
ECNA_NATIVE_MINT_ADDRESS=0x2509e87b12DAD407DC3521Dd15A95B3F74EF41D3
ECNA_FAUCET_ADDRESS=0x93994c8B2557B74Ae988640444268CD3473D6f68

EXPLORER_PUBLIC_URL=https://testnetexplorer.ecnascan.com
DASHBOARD_PUBLIC_URL=https://dashboard.ecnascan.com
PEER_EXPLORER_URL=https://explorer.ecnascan.com
PEER_NETWORK_LABEL=Mainnet

CORS_ORIGIN=https://ecnascan.com,https://www.ecnascan.com,https://testnetexplorer.ecnascan.com,https://testnetapi.ecnascan.com,https://explorer.ecnascan.com

SITE_AUTH_SECRET=change-me-testnet-auth-secret
SITE_AUTH_COOKIE_SECURE=1
RATE_LIMIT_MAX=300
INDEXER_POLL_MS=2000
INDEXER_BATCH_SIZE=500

FAUCET_ENABLED=1
FAUCET_PRIVATE_KEY=0x...
FAUCET_AMOUNT_WEI=1000000000000000000000
FAUCET_COOLDOWN_MS=86400000
FAUCET_MAX_PER_IP_PER_DAY=10

LOG_LEVEL=info
